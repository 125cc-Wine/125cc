{
  "headers": [
    {
      "source": "/vinos.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/(.*\\.(?:js|css|woff2?))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/nueva/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "images": {
    "sizes": [96, 192, 320, 640],
    "formats": ["image/webp"],
    "qualities": [75],
    "minimumCacheTTL": 2592000,
    "remotePatterns": [
      { "protocol": "https", "hostname": "9j5ebfwhvwtvrhy9.public.blob.vercel-storage.com", "pathname": "^/vinos/.*$" },
      { "protocol": "https", "hostname": "www.aromadevid.com.ar", "pathname": "^/wp-content/uploads/.*$" }
    ]
  },
  "crons": [
    { "path": "/api/sync-precios", "schedule": "0 9 * * *" }
  ],
  "functions": {
    "api/extraer-imagen.js": { "maxDuration": 30 }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/stats",    "dest": "/stats.html" },
    { "src": "/stats.html", "dest": "/stats.html" },
    { "src": "/pos",      "dest": "/pos.html" },
    { "src": "/pos.html", "dest": "/pos.html" },
    { "src": "/cuenta",      "dest": "/cuenta.html" },
    { "src": "/cuenta.html", "dest": "/cuenta.html" },
    { "src": "/cocina",      "dest": "/cocina.html" },
    { "src": "/cocina.html", "dest": "/cocina.html" },
    { "src": "/nueva",  "dest": "/nueva/index.html" },
    { "src": "/nueva/", "dest": "/nueva/index.html" },
    { "src": "/vinos.json", "dest": "/vinos.json" },
    { "src": "/(.*\\.(?:js|css|png|jpg|svg|ico|json|woff2?))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
